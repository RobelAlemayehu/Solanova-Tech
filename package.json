{
  "name": "proplist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PropList - Multi-tenant property listing platform monorepo",
  "scripts": {
    "dev": "pnpm --filter \"*\" dev",
    "build": "pnpm --filter \"*\" build",
    "start": "pnpm --filter \"*\" start",
    "lint": "eslint \"apps/**/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5"
  }
}
