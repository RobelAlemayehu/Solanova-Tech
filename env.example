# PropList Environment Variables
# Copy to the monorepo root as `.env`

# ─── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Backend (NestJS) ─────────────────────────────────────────────────────────
PORT=5000
DATABASE_URL=mongodb://localhost:27017/proplist
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary — required for image uploads in production
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Admin seed script (optional)
ADMIN_EMAIL=admin@proplist.dev
ADMIN_PASSWORD=Admin1234!

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
